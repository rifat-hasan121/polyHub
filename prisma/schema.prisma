generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ALUMNI
  ADMIN
}

enum Probidhan {
  PROBIDHAN_2016
  PROBIDHAN_2022
}

enum MaterialType {
  NOTE
  QUESTION_BANK
  SYLLABUS
  BOOK_PDF
}

enum MaterialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JobType {
  INDUSTRIAL_ATTACHMENT
  FULL_TIME
  PART_TIME
}

enum HigherStudyCategory {
  DUET_NON_DEPT
  DUET_DEPT
  PRIVATE_UNI
  ABROAD_STUDY
}

enum HigherStudyResourceType {
  STUDY_MATERIAL
  QUESTION_BANK
}

enum HigherStudyReactionType {
  LIKE
  DISLIKE
}

enum UniversityType {
  PUBLIC
  PRIVATE
  INTERNATIONAL
}

model User {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique
  passwordHash         String?
  image                String?
  role                 Role                  @default(STUDENT)
  polytechnic          String?
  department           String?
  probidhan            Probidhan?
  semester             Int?
  materials            Material[]
  savedMaterials       SavedMaterial[]
  projects             Project[]
  higherStudyResources HigherStudyResource[]
  higherStudyComments  HigherStudyComment[]
  higherStudyReactions HigherStudyReaction[]
  communityPosts       CommunityPost[]
  comments             Comment[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model Department {
  id       String    @id @default(cuid())
  name     String
  code     String    @unique
  subjects Subject[]
}

model Subject {
  id           String     @id @default(cuid())
  name         String
  code         String
  semester     Int
  probidhan    Probidhan
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  materials    Material[]

  @@unique([code, probidhan])
  @@index([departmentId, semester])
}

model Material {
  id              String          @id @default(cuid())
  title           String
  fileUrl         String
  type            MaterialType
  probidhan       Probidhan
  status          MaterialStatus  @default(PENDING)
  rejectionReason String?
  year            Int?
  subjectId       String
  userId          String
  subject         Subject         @relation(fields: [subjectId], references: [id])
  user            User            @relation(fields: [userId], references: [id])
  savedBy         SavedMaterial[]
  createdAt       DateTime        @default(now())

  @@index([status, subjectId])
}

model SavedMaterial {
  id         String   @id @default(cuid())
  userId     String
  materialId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, materialId])
  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  thumbnail   String?
  repoUrl     String?
  liveUrl     String?
  tags        String[]
  department  String
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model Opportunity {
  id          String    @id @default(cuid())
  title       String
  companyName String
  location    String
  type        JobType
  description String
  applyUrl    String?
  department  String[]
  deadline    DateTime?
  createdAt   DateTime  @default(now())
}

model HigherStudyResource {
  id               String                  @id @default(cuid())
  title            String
  description      String
  category         HigherStudyCategory
  resourceType     HigherStudyResourceType @default(STUDY_MATERIAL)
  isVerified       Boolean                 @default(true)
  department       String?
  subject          String?
  year             Int?
  fileUrl          String?
  videoUrl         String?
  questionPaperUrl String?
  answerKeyUrl     String?
  solutionUrl      String?
  status           MaterialStatus          @default(APPROVED)
  rejectionReason  String?
  userId           String?
  user             User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments         HigherStudyComment[]
  reactions        HigherStudyReaction[]
  createdAt        DateTime                @default(now())

  @@index([category, resourceType, createdAt])
  @@index([department, subject])
  @@index([userId, createdAt])
}

model HigherStudyComment {
  id         String              @id @default(cuid())
  content    String              @db.VarChar(2000)
  resourceId String
  userId     String
  resource   HigherStudyResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime            @default(now())

  @@index([resourceId, createdAt])
  @@index([userId])
}

model HigherStudyReaction {
  id         String                  @id @default(cuid())
  type       HigherStudyReactionType
  resourceId String
  userId     String
  resource   HigherStudyResource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@unique([resourceId, userId])
  @@index([userId])
}

model UniversityGuide {
  id               String         @id @default(cuid())
  name             String         @unique
  type             UniversityType
  waiverSummary    String
  costPerSemester  String?
  admissionDetails String?
  websiteUrl       String?
  circularUrl      String?
  createdAt        DateTime       @default(now())

  @@index([type, createdAt])
}

model BtebNotice {
  id          String       @id @default(cuid())
  btebId      String       @unique
  title       String
  publishDate String?
  fileUrl     String
  isImportant Boolean      @default(false)
  isResultPdf Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  examResults ExamResult[]
}

model ExamResult {
  id             String     @id @default(cuid())
  noticeId       String
  roll           String
  gpa            Float?
  passed         Boolean
  failedSubjects String[]
  notice         BtebNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())

  @@unique([noticeId, roll])
  @@index([roll])
}

model CommunityPost {
  id         String    @id @default(cuid())
  title      String
  content    String
  imageUrl   String?
  department String
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  comments   Comment[]
  createdAt  DateTime  @default(now())
}

model Comment {
  id        String        @id @default(cuid())
  content   String
  postId    String
  userId    String
  post      CommunityPost @relation(fields: [postId], references: [id])
  user      User          @relation(fields: [userId], references: [id])
  createdAt DateTime      @default(now())
}
